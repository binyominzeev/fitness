# Szerveroldali változók. Ne használj VITE_ előtagot az OpenAI-kulcshoz.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Az AI API-szerver portja (server/index.mjs). Fejlesztésben a Vite proxy is ezt használja.
PORT=8787
AI_SERVER_PORT=8787

# AI-kérések száma felhasználónként óránként (0 = nincs limit)
AI_RATE_LIMIT_PER_HOUR=60

DATABASE_PATH=./data/fitness.db

# Pocket ID OIDC (szerveroldali; a secret soha nem kerülhet VITE_ változóba)
OIDC_ISSUER=https://auth.binjomin.hu
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Pontosan egyeznie kell a Pocket ID-ban regisztrált redirect URI-val (origin + "/")
OIDC_REDIRECT_URI=http://localhost:5173/
# OIDC_AUDIENCE=

# Build-idejű, a frontend használja
VITE_OIDC_ISSUER=https://auth.binjomin.hu
VITE_OIDC_CLIENT_ID=
